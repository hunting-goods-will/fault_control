#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 1

        def Cylinder "geom" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Y"
            double height = 0.05
            double radius = 0.03
        }
    }

    def Xform "Arm" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.5
        double3 xformOp:translate = (0, 0, -0.15)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Capsule "geom" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.3
            double radius = 0.02
        }
    }

    def PhysicsFixedJoint "BaseFixed" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        rel physics:body1 = </World/Base>
    }

    def PhysicsRevoluteJoint "PivotJoint" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        float drive:angular:physics:damping = 0
        float drive:angular:physics:maxForce = 1000000
        float drive:angular:physics:stiffness = 0
        uniform token drive:angular:physics:type = "force"
        uniform token physics:axis = "Y"
        rel physics:body0 = </World/Base>
        rel physics:body1 = </World/Arm>
        point3f physics:localPos0 = (0, 0, 0)
        point3f physics:localPos1 = (0, 0, 0.15)
    }
}

